# ── Configuración del Servidor ────────────────────────────────────────────────
PORT=4000
API_GLOBAL_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# ── Base de Datos PostgreSQL (Supabase Session Pooler) ────────────────────────
# Reemplazar [TU_PASSWORD] por la contraseña de la base de datos de Supabase
DATABASE_URL=postgresql://postgres.whettfyyqvdhobbiyqdq:[TU_PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# ── Autenticación JWT ─────────────────────────────────────────────────────────
# Generar una clave secreta propia en consola con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=1d

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Supabase Storage (Subida de Archivos) ─────────────────────────────────────
SUPABASE_URL=https://whettfyyqvdhobbiyqdq.supabase.co/
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui
SUPABASE_STORAGE_BUCKET=turismo